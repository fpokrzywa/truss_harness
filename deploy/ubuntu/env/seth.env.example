# /etc/seth/seth.env: shifde-api and shifde-worker (seth-api.service, seth-worker.service).
# Install as 0640 root:seth. Read by systemd (EnvironmentFile=); never put it under /opt/seth.
# The owner credential (SHIFDE_MIGRATION_DATABASE_URL) is NOT here: it lives in admin.env.
# Each secret below may instead be given as SHIFDE_<NAME>_FILE (the path of a file holding it).
SHIFDE_ENV=production

# Application role (shifde_app) from scripts/hosted_db.py setup; TLS to the separate database host.
SHIFDE_DATABASE_URL=postgresql+psycopg://shifde_app:<generate: from scripts/hosted_db.py setup>@<db host: owner to confirm>:5432/<database: owner to confirm>?sslmode=verify-full&sslrootcert=/etc/seth/db-ca.pem

# The API listens on loopback only; the nginx edge on the same host is its one proxy.
SHIFDE_API_HOST=127.0.0.1
SHIFDE_API_PORT=8710
SHIFDE_TRUSTED_PROXIES=127.0.0.1/32
SHIFDE_TRUST_LOOPBACK_PROXY=false

SHIFDE_ALLOWED_ORIGINS=https://<domain: owner to confirm>
SHIFDE_PUBLIC_BASE_URL=https://<domain: owner to confirm>

SHIFDE_HSTS_MAX_AGE_SECONDS=31536000
SHIFDE_API_DOCS_ENABLED=false
SHIFDE_AUTH_LOCAL_ENABLED=false
SHIFDE_LOG_FORMAT=json

# Generated once per database and never changed (stored secrets are encrypted with the ring).
# scripts/hosted_db.py setup generates the pepper and the ring; keep a copy of the ring off this
# host: it is not in the backup.
SHIFDE_API_KEY_PEPPER=<generate: from scripts/hosted_db.py setup>
SHIFDE_SECRET_KEYS=<generate: from scripts/hosted_db.py setup, as id:base64-32-bytes>
SHIFDE_METRICS_TOKEN=<generate: openssl rand -base64 32>

# Worker liveness and readiness on loopback (seth-worker.service ExecStartPost); never opened.
SHIFDE_WORKER_HEALTH_HOST=127.0.0.1
SHIFDE_WORKER_HEALTH_PORT=8711
