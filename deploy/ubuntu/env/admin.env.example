# /etc/seth/admin.env: the schema owner credential, for `seth-admin` and seth-backup.service only.
# Install as 0600 root:root. systemd (PID 1) reads it, so no service user can.
SHIFDE_MIGRATION_DATABASE_URL=postgresql+psycopg://shifde_owner:<generate: from scripts/hosted_db.py setup>@<db host: owner to confirm>:5432/<database: owner to confirm>?sslmode=verify-full&sslrootcert=/etc/seth/db-ca.pem
SHIFDE_PG_BIN_DIR=/usr/lib/postgresql/17/bin
