# /etc/seth/executor/<org>.env: one organization's executor (seth-executor@<org>.service).
# Install as 0600 root:root: systemd (PID 1) reads it for this instance only.
SHIFDE_ENV=production
# The public origin, through the nginx edge (https is required outside development and test).
SHIFDE_EXECUTOR_API_URL=https://<domain: owner to confirm>
# The shx_ credential from this organization's Executors screen.
SHIFDE_EXECUTOR_TOKEN=<generate: from the Executors screen of this organization>
# 0600 seth-exec-<org>, this instance's own user; every entry carries this organization's id as
# tenant_id.
SHIFDE_EXECUTOR_CREDENTIALS_FILE=/etc/seth/executor/<org>.credentials.json
# Liveness and readiness on loopback; one port per instance (8720, 8721, ...), never opened.
SHIFDE_EXECUTOR_HEALTH_HOST=127.0.0.1
SHIFDE_EXECUTOR_HEALTH_PORT=8720
