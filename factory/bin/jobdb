#!/usr/bin/env python
"""A job's own app database. Thin wrapper over scripts/dev_db.py, which already gives every
worktree its own database (`shifde_<worktree name>`) and `.devdata/dev.env` in the shared cluster.

Usage:
  jobdb env            from the job's worktree: python scripts/dev_db.py env (create the database,
                       write <worktree>/.devdata/dev.env). checks.sh does this too.
  jobdb ensure         env, then migrate the database with the worktree's migrations and seed dev
                       users into <worktree>/.devdata/dev-users.txt. Run before starting the API.
  jobdb drop <job-id>  drop the job's database. `job` runs it when a job is merged or rejected.

dev_db.py is the single source of the database name and credentials; nothing is read or printed here.
"""

import importlib.util
import os
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]


def die(msg):
    print(f"jobdb: {msg}", file=sys.stderr)
    sys.exit(1)


def dev_db():
    spec = importlib.util.spec_from_file_location("dev_db", REPO / "scripts" / "dev_db.py")
    module = importlib.util.module_from_spec(spec)
    sys.modules["dev_db"] = module
    spec.loader.exec_module(module)
    return module


def worktree():
    top = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    if top.returncode != 0:
        die(f"{Path.cwd()} isn't a git checkout")
    wt = Path(top.stdout.strip()).resolve()
    if wt == REPO.resolve():
        die("run this from a job's worktree, never the main checkout: its database is the shared dev database")
    return wt


def cmd_env():
    wt = worktree()
    res = subprocess.run([sys.executable, str(REPO / "scripts" / "dev_db.py"), "env"], cwd=wt)
    if res.returncode != 0:
        die("scripts/dev_db.py env failed (is the cluster running? python scripts/dev_db.py start)")
    return wt


def cmd_ensure():
    wt = cmd_env()
    env = dict(os.environ, SHIFDE_ENV="development", UV_LINK_MODE="copy")
    for key in ("SHIFDE_DATABASE_URL", "SHIFDE_MIGRATION_DATABASE_URL"):
        env.pop(key, None)  # the worktree's dev.env decides, never an inherited shared URL
    seeded = (wt / ".devdata" / "dev-users.txt").exists()
    for args in (["db", "upgrade"],) + (() if seeded else (["dev-seed"],)):
        res = subprocess.run(["uv", "run", "--frozen", "shifde-admin", *args], cwd=wt / "backend", env=env)
        if res.returncode != 0:
            die(f"shifde-admin {' '.join(args)} failed in {wt / 'backend'}")
    print(f"jobdb: {wt.name}'s database is migrated; sign-in users are in {wt / '.devdata' / 'dev-users.txt'}")


def cmd_drop(job_id):
    mod = dev_db()
    wt = REPO / ".worktrees" / job_id
    name = mod.database_name(wt, REPO)
    if name == "shifde":
        die("refusing to drop the shared dev database")
    try:
        mod.Cluster(REPO).psql(f'DROP DATABASE IF EXISTS "{name}" WITH (FORCE)')
    except mod.DevDbError as exc:
        die(str(exc))
    print(f"jobdb: dropped {name} (if it existed)")


def main(argv):
    if argv == ["env"]:
        cmd_env()
    elif argv == ["ensure"]:
        cmd_ensure()
    elif len(argv) == 2 and argv[0] == "drop":
        cmd_drop(argv[1])
    else:
        die(__doc__.strip())


if __name__ == "__main__":
    main(sys.argv[1:])
